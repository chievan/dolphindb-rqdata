try { loadPlugin("httpClient") } catch(ex) { }
use RQData

/*
 * 任务：鉴权 -> 列出黄金合约 -> 取 AU2412 一段日线 -> 显式转型
 */

// ====================================================
// 第一步：鉴权
// RQSDK 发放的是 License Key：许可证模式下 user 固定填 "license"，Key 当密码用
// 注意：License Key 属敏感信息，不要提交到公开仓库
// ====================================================
user = "license"
// 本机运行前替换为你的 License Key；仓库内只保留占位符，禁止提交真实值
pwd = "<YOUR_RQSDK_LICENSE_KEY>"

token = RQData::rqGetToken(user, pwd)
print("token 获取成功: " + substr(token, 0, 8) + "...")

// ====================================================
// 第二步：全量合约清单，找出黄金合约
// 期货的 order_book_id 不带交易所后缀（AU2412），交易所看 exchange 列
// ====================================================
print("\n[1/3] 正在获取全量期货合约清单...")

inst = RQData::rqAllInstruments(user, pwd, "Future")
print("RQData 期货合约总数: " + string(inst.rows()))

au = select order_book_id, exchange, contract_multiplier, listed_date, de_listed_date
     from inst where regexReplace(order_book_id, "[0-9]+", "") == "AU"
print("黄金合约数量: " + string(au.rows()))
print(au)

// ====================================================
// 第三步：按合约代码取日线
// 日线返回 datetime 索引，没有 date / trading_date 列（分钟线才有 trading_date）
// ====================================================
print("\n[2/3] 正在获取 AU2412 日线行情...")

tb = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.18, "1d")
print("日线行数: " + string(tb.rows()))
print(tb)

// ====================================================
// 第四步：数值列显式转型（模块统一返回 STRING）
// ====================================================
print("\n[3/3] 转型为数值列：")

res = select temporalParse(datetime, "yyyy-MM-dd") as trade_date,
             double(open) as open,
             double(high) as high,
             double(low) as low,
             double(close) as close,
             double(volume) as volume,
             double(total_turnover) as turnover,
             double(open_interest) as open_interest,
             double(settlement) as settle,
             double(prev_settlement) as pre_settle
      from tb
print(res)

print("\n--- 任务执行完成 ---")
