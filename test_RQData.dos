// --- 1.21 rqFutTradingParams (期货交易参数) ---
print("\n=== 测试 rqFutTradingParams (期货交易参数) ===")
@testing:case = "test_rqFutTradingParams"
// 手续费 / 保证金率 / 限仓 / 单笔最大下单量
tp = RQData::rqFutTradingParams(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09)
assert 1, tp.rows() == 2
assert 2, "open_commission" in tp.columnNames()
// 保证金率按多空分列，没有单一的 margin_rate
assert 3, "long_margin_ratio" in tp.columnNames()
assert 4, "short_margin_ratio" in tp.columnNames()
assert 5, all(double(tp["long_margin_ratio"]) > 0)

// --- 1.22 rqFutDominantPrice (主力连续行情) ---
print("\n=== 测试 rqFutDominantPrice (主力连续行情) ===")
@testing:case = "test_rqFutDominantPrice"
// 主力连续复权行情：dominant_id 固定返回，adjust_type 影响 close
dpNone = RQData::rqFutDominantPrice(user, pwd, ["AU"], 2024.10.08, 2024.10.09, "none", "1d", ["close"])
assert 1, dpNone.rows() == 2
assert 2, "dominant_id" in dpNone.columnNames()
assert 3, all(dpNone["dominant_id"] like "AU%")
dpPre = RQData::rqFutDominantPrice(user, pwd, ["AU"], 2024.10.08, 2024.10.08, "pre", "1d", ["close"])
assert 4, dpPre["close"][0] > dpNone["close"][0]

