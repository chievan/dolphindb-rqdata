@testing:case = "test_rqGetPrice_start_null", exception=1
// 必填日期传 NULL 会直接报错，避免静默返回全历史
RQData::rqGetPrice(user, pwd, ["AU2412"], NULL, 2024.10.09, "1d")

@testing:case = "test_rqGetPrice_end_null", exception=1
RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, NULL, "1d")

@testing:case = "test_rqGetPrice_frequency_type", exception=1
