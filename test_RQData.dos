// ====================================================
// 第三部分：功能反向测试 (内容层)
// ====================================================

// --- 3.1 rqGetPrice ---
@testing:case = "test_rqGetPrice_invalid_code"
// 代码不存在
okErr = false
try { RQData::rqGetPrice(user, pwd, ["INVALID"], 2024.10.08, 2024.10.09, "1d") } catch(ex) { okErr = true }
assert 1, okErr

@testing:case = "test_rqGetPrice_code_with_suffix"
// 期货代码带交易所后缀（AU2412.SHF）会被拒绝
okErr = false
try { RQData::rqGetPrice(user, pwd, ["AU2412.SHF"], 2024.10.08, 2024.10.09, "1d") } catch(ex) { okErr = true }
assert 1, okErr

@testing:case = "test_rqGetPrice_mixed_codes"
// 有效与无效代码混合：服务端部分返回，只保留有效合约
tbMixed = RQData::rqGetPrice(user, pwd, ["AU2412", "INVALID"], 2024.10.08, 2024.10.09, "1d", ["close"])
assert 1, tbMixed.rows() > 0
assert 2, any(tbMixed["order_book_id"] == "AU2412")
assert 3, !any(tbMixed["order_book_id"] == "INVALID")

@testing:case = "test_rqGetPrice_invalid_frequency"
// 不支持的频率
okErr = false
try { RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09, "1x") } catch(ex) { okErr = true }
assert 1, okErr

@testing:case = "test_rqGetPrice_invalid_fields"
// 字段名错误
okErr = false
try { RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09, "1d", ["foo"]) } catch(ex) { okErr = true }
assert 1, okErr

@testing:case = "test_rqGetPrice_minute_with_daily_fields"
// 分钟线不支持 settlement 等日线字段
okErr = false
try { RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09, "1m", ["settlement"]) } catch(ex) { okErr = true }
assert 1, okErr

@testing:case = "test_rqGetPrice_night_session_trading_date"
// 夜盘（2024-10-08 21:00 之后）应归属到下一交易日 2024-10-09
tbNight = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.09, 2024.10.09, "1m", ["trading_date", "close"])
assert 1, tbNight.rows() > 0
assert 2, any(tbNight["datetime"] like "2024-10-08 21:%")
assert 3, all(tbNight["trading_date"] like "2024-10-09%")

