// ====================================================
// 第四部分：落库冒烟测试（建库建表 / 基础信息 / 单日行情）
// ====================================================

@testing:case = "test_rqInitDb"
print("\n=== 测试 rqInitDb (建库建表) ===")
syncRqData::rqInitDb()
assert 1, existsTable("dfs://RQDATA.futu_bar", "data")
assert 2, existsTable("dfs://RQDATA.futu_contract", "data")
assert 3, existsTable("dfs://RQDATA.futu_calendar", "data")
assert 4, existsTable("dfs://RQDATA.futu_synclog", "data")
print("建库建表验证通过")

@testing:case = "test_rqFetchInstruments"
print("\n=== 测试 rqFetchInstruments (合约清单) ===")
instT = syncRqData::rqFetchInstruments(user, pwd)
instCnt = select count(*) as n from instT
assert 1, instCnt.n[0] > 0
// margin_rate / industry_name 来自 RQData all_instruments
instAu = select count(*) as n from instT where variety == "AU" and !isNull(margin_ratio)
assert 2, instAu.n[0] > 0
instInd = select count(*) as n from instT where industry != ""
assert 3, instInd.n[0] > 0
print("合约清单验证通过，合约数=" + string(instCnt.n[0]))

@testing:case = "test_rqSyncBars_one_day"
print("\n=== 测试 rqSyncBars (单日日线落库) ===")
syncRqData::rqSyncBars(user, pwd, 2024.10.08, 2024.10.08, "1d", 50)
barT = loadTable("dfs://RQDATA.futu_bar", "data")
conT = loadTable("dfs://RQDATA.futu_contract", "data")
barCnt = select count(*) as n from barT where trade_date == 2024.10.08 and interval == "1d"
assert 1, barCnt.n[0] > 0
conCnt = select count(*) as n from conT where trade_date == 2024.10.08
assert 2, conCnt.n[0] >= barCnt.n[0]
// 上市期间每个交易日都应有 contract 行（与当日是否有成交无关）
listed = select count(*) as n from instT
    where (isNull(list_date) or list_date <= 2024.10.08)
      and (isNull(last_date) or last_date >= 2024.10.08)
assert 3, conCnt.n[0] == listed.n[0]
assert 4, "industry" in conT.columnNames()
// 连续合约：88（主力）/888（价差平滑）/99（指数）随正常合约一并入库，且 88/888 带当日主力代码
contCnt = select count(*) as n from conT where trade_date == 2024.10.08 and (symbol like "%88" or symbol like "%99")
assert 5, contCnt.n[0] > 0
domCnt = select count(*) as n from conT where trade_date == 2024.10.08 and symbol == "AU888" and dominant_id != ""
assert 6, domCnt.n[0] == 1
assert 7, "dominant_id" in conT.columnNames()
print("日线落库验证通过，bar=" + string(barCnt.n[0]) + " contract=" + string(conCnt.n[0]) +
      " 当日上市合约=" + string(listed.n[0]))

@testing:case = "test_rqDailyPreSettle"
print("\n=== 测试 rqDailyPreSettle (分钟线昨结算映射) ===")
// 分钟线不返回 prev_settlement，用同日日线的 prev_settlement 建映射
pm = syncRqData::rqDailyPreSettle(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09)
assert 1, pm.rows() == 2
pm0909 = select v from pm where k == "AU2412|20241009"
assert 2, pm0909.rows() == 1 and !isNull(pm0909.v[0])
print("昨结算映射验证通过，AU2412 20241009 pre_settle=" + string(pm0909.v[0]))

// ====================================================
// 第五部分：依赖校验 (Dependency Checks)
// ====================================================

@testing:case = "test_dependency_httpClient"
print("\n=== 测试 依赖校验 ===")
// 注意：插件已加载时重复 loadPlugin 会抛异常，不能用它判断依赖是否可用
// 这里直接验证插件能发起一次真实 HTTP 请求
pluginOk = false
try { pluginOk = (RQData::rqApi(token, pNormal)["responseCode"] == 200) } catch(ex) { pluginOk = false }
assert 1, pluginOk
print("httpClient 插件依赖验证通过")

@testing:case = "test_dependency_module_loaded"
assert 1, "RQData" in getLoadedModules().moduleName
assert 2, "syncRqData" in getLoadedModules().moduleName
print("模块依赖验证通过")

print("\n--- 全部测试执行完成 ---")
