@testing:case = "test_rqParseCsv_arg_count_less", syntaxError=1
RQData::rqParseCsv()

@testing:case = "test_rqParseCsv_arg_count_more", syntaxError=1
RQData::rqParseCsv("a,b", "extra")

@testing:case = "test_rqParseCsv_column_mismatch"
