// ====================================================
// 第二部分：系统化异常校验 (参数层)
// ====================================================

// --- 2.1 rqGetToken ---
@testing:case = "test_rqGetToken_arg_count_less"
okSyntaxErr = false
try { parseExpr("RQData::rqGetToken(user)").eval() } catch(ex) { okSyntaxErr = true }
assert 1, okSyntaxErr

@testing:case = "test_rqGetToken_arg_count_more"
okSyntaxErr = false
try { parseExpr("RQData::rqGetToken(user, pwd, false, \"extra\")").eval() } catch(ex) { okSyntaxErr = true }
assert 1, okSyntaxErr

@testing:case = "test_rqGetToken_user_null"
okErr = false
try { RQData::rqGetToken(NULL, pwd, true) } catch(ex) { okErr = true }
assert 1, okErr

@testing:case = "test_rqGetToken_pwd_null"
okErr = false
try { RQData::rqGetToken(user, NULL, true) } catch(ex) { okErr = true }
assert 1, okErr

@testing:case = "test_rqGetToken_bad_credential"
okErr = false
try { RQData::rqGetToken("bad_user", "bad_password", true) } catch(ex) { okErr = true }
assert 1, okErr

// --- 2.2 rqApi ---
@testing:case = "test_rqApi_arg_count_less"
okSyntaxErr = false
try { parseExpr("RQData::rqApi(token)").eval() } catch(ex) { okSyntaxErr = true }
assert 1, okSyntaxErr

@testing:case = "test_rqApi_arg_count_more"
okSyntaxErr = false
try { parseExpr("RQData::rqApi(token, pNormal, 60000, \"extra\")").eval() } catch(ex) { okSyntaxErr = true }
assert 1, okSyntaxErr

@testing:case = "test_rqApi_token_type"
// token 非字符串：插件层抛异常，或被服务端判为非法 token（401），两者都算通过
okTokenType = false
try {
    rTokenType = RQData::rqApi(12345, pNormal)
    okTokenType = (rTokenType["responseCode"] == 401)
} catch(ex) {
    okTokenType = true
}
assert 1, okTokenType

@testing:case = "test_rqApi_token_null"
// token 为 NULL：插件层抛异常，或被服务端判为非法 token（401），两者都算通过
okTokenNull = false
try {
    rTokenNull = RQData::rqApi(NULL, pNormal)
    okTokenNull = (rTokenNull["responseCode"] == 401)
} catch(ex) {
    okTokenNull = true
}
assert 1, okTokenNull

@testing:case = "test_rqApi_params_type"
// params 非字典：本地序列化抛异常，或服务端返回非 200，两者都算通过
okParamsType = false
try {
    rParamsType = RQData::rqApi(token, 123)
    okParamsType = (rParamsType["responseCode"] != 200)
} catch(ex) {
    okParamsType = true
