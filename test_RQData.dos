// --- 1.27 rqCapitalFlow (资金流) ---
print("\n=== 测试 rqCapitalFlow (资金流) ===")
@testing:case = "test_rqCapitalFlow"
cf = RQData::rqCapitalFlow(user, pwd, ["000001.XSHE"], 2024.10.08, 2024.10.10)
assert 1, cf.rows() == 3
assert 2, "buy_value" in cf.columnNames()
assert 3, "sell_value" in cf.columnNames()

@testing:case = "test_rqCapitalFlow_future_empty"
// 资金流只对股票有数据，期货返回空表
cfFut = RQData::rqCapitalFlow(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09)
assert 1, cfFut.rows() == 0

// --- 1.28 rqShareTransformation (股份变动) ---
print("\n=== 测试 rqShareTransformation (股份变动) ===")
@testing:case = "test_rqShareTransformation"
st = RQData::rqShareTransformation(user, pwd)
assert 1, st.rows() > 0
assert 2, "successor" in st.columnNames()
assert 3, "event" in st.columnNames()

