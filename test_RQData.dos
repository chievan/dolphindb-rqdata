// RQData 模块测试脚本（覆盖 26 个公开接口，不含落库与同步逻辑）
// 运行方式：在 DolphinDB 节点上整段执行即可（支持 local8848 等普通会话）
//   - @testing:case 仅为用例标签，普通会话会忽略
//   - 参数个数不足/过多用 syntaxError=1；类型错误/空值/格式错误/逻辑反转用 exception=1
//   - 预期异常直接写调用语句，由注解声明预期，不包裹 try/catch
//   - 凭证必须替换为自己的 RQSDK License Key，切勿提交到公开仓库
try { loadPlugin("httpClient") } catch(ex) {}
use RQData

// 1. 设置凭证：RQSDK 许可证模式（user 固定 "license"，pwd 为 License Key）
//    账号密码模式改为：user = "your_user_name" / pwd = "your_password"
user = "license"
pwd = "<YOUR_RQSDK_LICENSE_KEY>"

// 2. 获取 AccessToken 并复用（token 有效期 2 小时，重复获取会让旧 token 失效）
token = RQData::rqGetToken(user, pwd)
print("AccessToken 获取成功: " + substr(token, 0, 8) + "...")

@testing:case = "test_module_info"
print("\n=== 测试 module_info (模块信息) ===")
info = getLoadedModules()
assert 0, "RQData" in info.moduleName
print("module_info 验证通过")

// ====================================================
// 第一部分：功能测试 (Functional Tests)
// ====================================================

// 公共请求参数（供 rqApi / rqRequest 复用）
pNormal = dict(STRING, ANY)
pNormal["m"] = "get_trading_dates"
pNormal["start_date"] = 20241104
pNormal["end_date"] = 20241105

// --- 1.1 rqGetToken (凭证与 token 缓存) ---
print("\n=== 测试 rqGetToken (凭证) ===")
@testing:case = "test_rqGetToken_format"
// 许可证模式的 /auth 返回裸 token 文本（非 JSON），长度远大于 20
assert 1, strlen(token) > 20
assert 2, substr(token, 0, 1) != "{"

@testing:case = "test_rqGetToken_cache"
// 未过期时应命中缓存，不重新请求
tokenCache = RQData::rqGetToken(user, pwd)
assert 1, tokenCache == token
assert 2, RQData::rqTokenRead(user) == token

@testing:case = "test_rqGetToken_force"
// force=true 强制换新 token，旧 token 立即失效
tokenForced = RQData::rqGetToken(user, pwd, true)
assert 1, strlen(tokenForced) > 20
assert 2, RQData::rqTokenRead(user) == tokenForced
// 新 token 可直接用于后续请求
assert 3, RQData::rqApi(tokenForced, pNormal)["responseCode"] == 200
token = tokenForced

// --- 1.2 rqApi (通用 HTTP 调用) ---
print("\n=== 测试 rqApi (通用调用) ===")
@testing:case = "test_rqApi_basic"
resp = RQData::rqApi(token, pNormal)
assert 1, resp["responseCode"] == 200
assert 2, "text" in resp.keys()
assert 3, strpos(string(resp["text"]), "trading_date") >= 0

@testing:case = "test_rqApi_custom_timeout"
// 自定义超时
assert 1, RQData::rqApi(token, pNormal, 60000)["responseCode"] == 200

@testing:case = "test_rqApi_invalid_token"
// 非法 token 不抛异常，由返回值携带 401
assert 1, RQData::rqApi("INVALID_TOKEN_XXX", pNormal)["responseCode"] == 401

// --- 1.3 rqRequest (401 自动重登) ---
print("\n=== 测试 rqRequest (401 自动重登) ===")
@testing:case = "test_rqRequest_auto_relogin"
// 故意把缓存里的 token 写成非法值，rqRequest 应自动换 token 后重试成功
RQData::rqTokenWrite(user, "INVALID_TOKEN_XXX")
respRe = RQData::rqRequest(user, pwd, pNormal)
assert 1, respRe["responseCode"] == 200
assert 2, RQData::rqTokenRead(user) != "INVALID_TOKEN_XXX"
token = RQData::rqTokenRead(user)

// --- 1.4 rqParseCsv (CSV 解析) ---
print("\n=== 测试 rqParseCsv (CSV 解析) ===")
@testing:case = "test_rqParseCsv_normal"
csv = ",order_book_id,datetime,open,close\n0,AU2412,2024-10-08,1.5,2.5\n1,RB2410,2024-10-09,3.5,4.5"
tbCsv = RQData::rqParseCsv(csv)
assert 1, tbCsv.rows() == 2
assert 2, eqObj(tbCsv.columnNames(), ["rq_col_0", "order_book_id", "datetime", "open", "close"])
assert 3, tbCsv["order_book_id"][0] == "AU2412"
assert 4, tbCsv["close"][1] == "4.5"

@testing:case = "test_rqParseCsv_empty"
// 空响应（如空区间行情）应返回 0 行 1 列
tbEmptyCsv = RQData::rqParseCsv("")
assert 1, tbEmptyCsv.rows() == 0
assert 2, tbEmptyCsv.columns() == 1

@testing:case = "test_rqParseCsv_crlf"
// Windows 换行符
tbCrlf = RQData::rqParseCsv("a,b\r\n1,2\r\n3,4")
assert 1, tbCrlf.rows() == 2
assert 2, tbCrlf["b"][1] == "4"

@testing:case = "test_rqParseCsv_dup_columns"
// 重复列名自动去重
tbDup = RQData::rqParseCsv("a,a,a\n1,2,3")
assert 1, eqObj(tbDup.columnNames(), ["a", "a_1", "a_2"])
assert 2, tbDup.rows() == 1

@testing:case = "test_rqParseCsv_quoted_header"
// 表头带引号
tbQuote = RQData::rqParseCsv("\"order_book_id\",\"close\"\nAU2412,596.2")
assert 1, eqObj(tbQuote.columnNames(), ["order_book_id", "close"])
assert 2, tbQuote["close"][0] == "596.2"

@testing:case = "test_rqParseCsv_header_only"
// 只有表头没有数据行
tbHeaderOnly = RQData::rqParseCsv("a,b")
assert 1, tbHeaderOnly.rows() == 0
assert 2, tbHeaderOnly.columns() == 2

// --- 1.5 rqGetPrice 日线 ---
print("\n=== 测试 rqGetPrice (日线) ===")
@testing:case = "test_rqGetPrice_daily"
tbDaily = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.18, "1d")
assert 1, tbDaily.rows() > 0
assert 2, "datetime" in tbDaily.columnNames()
assert 3, "settlement" in tbDaily.columnNames()
assert 4, "limit_up" in tbDaily.columnNames()
// 日线没有 trading_date 字段
assert 5, !("trading_date" in tbDaily.columnNames())

@testing:case = "test_rqGetPrice_multi_ids"
// 多合约同时取
tbMulti = RQData::rqGetPrice(user, pwd, ["AU2412", "RB2410", "AG2412"], 2024.10.08, 2024.10.09, "1d", ["close"])
assert 1, tbMulti.rows() >= 3
assert 2, size(distinct(tbMulti["order_book_id"])) == 3

@testing:case = "test_rqGetPrice_custom_fields"
// 自定义字段只返回请求的列（datetime 始终返回）
tbCustom = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09, "1d", ["open", "close"])
colsCustom = tbCustom.columnNames()
assert 1, size(colsCustom) == 4
assert 2, "open" in colsCustom
assert 3, "close" in colsCustom
assert 4, !("settlement" in colsCustom)

@testing:case = "test_rqGetPrice_string_dates"
// 日期格式兼容：字符串与 DATE 结果一致
tbString = RQData::rqGetPrice(user, pwd, ["AU2412"], "2024-10-08", "2024-10-18", "1d")
assert 1, tbString.rows() == tbDaily.rows()

@testing:case = "test_rqGetPrice_weekend_empty"
// 周末区间无数据，返回 0 行
tbWeekend = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.12, 2024.10.13, "1d")
assert 1, tbWeekend.rows() == 0

@testing:case = "test_rqGetPrice_start_after_end"
// start > end 不报错，返回空表
tbReverse = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.18, 2024.10.08, "1d")
assert 1, tbReverse.rows() == 0

@testing:case = "test_rqGetPrice_future_date"
// 未来区间无数据
tbFuture = RQData::rqGetPrice(user, pwd, ["AU2412"], 2030.01.01, 2030.01.10, "1d")
assert 1, tbFuture.rows() == 0

// --- 1.6 rqGetPrice 分钟线 ---
print("\n=== 测试 rqGetPrice (分钟线) ===")
@testing:case = "test_rqGetPrice_1m"
tb1m = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09, "1m")
assert 1, tb1m.rows() > 0
assert 2, "datetime" in tb1m.columnNames()
// 默认字段按频率自动补齐 trading_date
assert 3, "trading_date" in tb1m.columnNames()
// 分钟线不支持的日线字段不应出现在默认结果里
assert 4, !("settlement" in tb1m.columnNames())

@testing:case = "test_rqGetPrice_5m_60m"
tb5m = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09, "5m")
assert 1, tb5m.rows() > 0
assert 2, "trading_date" in tb5m.columnNames()
tb60m = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09, "60m")
assert 3, tb60m.rows() > 0
assert 4, "trading_date" in tb60m.columnNames()

@testing:case = "test_rqGetPrice_1m_custom_fields"
tb1mCustom = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.08, "1m", ["close", "trading_date"])
cols1m = tb1mCustom.columnNames()
assert 1, "close" in cols1m
assert 2, "trading_date" in cols1m
assert 3, !("open_interest" in cols1m)

@testing:case = "test_rqGetPrice_night_session_trading_date"
// 夜盘（2024-10-08 21:00 之后）应归属到下一交易日 2024-10-09
tbNight = RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.09, 2024.10.09, "1m", ["trading_date", "close"])
assert 1, tbNight.rows() > 0
assert 2, any(tbNight["datetime"] like "2024-10-08 21:%")
assert 3, all(tbNight["trading_date"] like "2024-10-09%")

// --- 1.7 rqGetPrice 股票/指数/基金 ---
print("\n=== 测试 rqGetPrice (股票/指数/基金) ===")
@testing:case = "test_rqGetPrice_stock_daily"
tbStock = RQData::rqGetPrice(user, pwd, ["000001.XSHE"], 2024.10.08, 2024.10.09, "1d")
assert 1, tbStock.rows() == 2
assert 2, "prev_close" in tbStock.columnNames()
assert 3, !("open_interest" in tbStock.columnNames())
assert 4, !("settlement" in tbStock.columnNames())

@testing:case = "test_rqGetPrice_index_daily"
tbIndex = RQData::rqGetPrice(user, pwd, ["000300.XSHG"], 2024.10.08, 2024.10.09, "1d")
assert 1, tbIndex.rows() == 2
assert 2, "prev_close" in tbIndex.columnNames()

@testing:case = "test_rqGetPrice_fund_daily"
// 场内 ETF 行情表现同股票
tbFund = RQData::rqGetPrice(user, pwd, ["510300.XSHG"], 2024.10.08, 2024.10.09, "1d")
assert 1, tbFund.rows() == 2
assert 2, "prev_close" in tbFund.columnNames()

@testing:case = "test_rqGetPrice_stock_1m"
tbStock1m = RQData::rqGetPrice(user, pwd, ["000001.XSHE"], 2024.10.08, 2024.10.08, "1m")
assert 1, tbStock1m.rows() > 0
// 股票分钟线既没有 trading_date，也没有 prev_close
assert 2, !("trading_date" in tbStock1m.columnNames())
assert 3, !("prev_close" in tbStock1m.columnNames())

@testing:case = "test_rqGetPrice_mixed_codes"
// 有效与无效代码混合：服务端部分返回，只保留有效合约
tbMixed = RQData::rqGetPrice(user, pwd, ["AU2412", "INVALID"], 2024.10.08, 2024.10.09, "1d", ["close"])
assert 1, tbMixed.rows() > 0
assert 2, any(tbMixed["order_book_id"] == "AU2412")
assert 3, !any(tbMixed["order_book_id"] == "INVALID")

// --- 1.8 rqAllInstruments (全量合约) ---
print("\n=== 测试 rqAllInstruments (全量合约) ===")
@testing:case = "test_rqAllInstruments_future"
inst = RQData::rqAllInstruments(user, pwd, "Future")
assert 1, inst.rows() > 0
assert 2, "order_book_id" in inst.columnNames()
assert 3, "exchange" in inst.columnNames()
assert 4, "underlying_symbol" in inst.columnNames()
assert 5, "contract_multiplier" in inst.columnNames()

@testing:case = "test_rqAllInstruments_code_format"
// 期货代码不带交易所后缀，交易所信息在 exchange 列
auInst = select order_book_id, exchange from inst where underlying_symbol == "AU"
assert 1, auInst.rows() > 0
assert 2, sum(auInst["order_book_id"] like "%.%") == 0
assert 3, all(auInst["exchange"] == "SHFE")

@testing:case = "test_rqAllInstruments_contract_meta"
au2412 = select * from inst where order_book_id == "AU2412"
assert 1, au2412.rows() == 1
assert 2, au2412["contract_multiplier"][0] != ""
assert 3, au2412["maturity_date"][0] != ""

// --- 1.9 rqInstruments (合约详情) ---
print("\n=== 测试 rqInstruments (合约详情) ===")
@testing:case = "test_rqInstruments_stock"
instStock = RQData::rqInstruments(user, pwd, ["000001.XSHE"])
assert 1, instStock.rows() == 1
assert 2, instStock["order_book_id"][0] == "000001.XSHE"
assert 3, "industry_name" in instStock.columnNames()

@testing:case = "test_rqInstruments_future"
instFut = RQData::rqInstruments(user, pwd, ["AU2412"])
assert 1, instFut.rows() == 1
assert 2, "contract_multiplier" in instFut.columnNames()
assert 3, instFut["exchange"][0] == "SHFE"

@testing:case = "test_rqInstruments_invalid_code"
// 不存在的代码不报错，返回空表（CSV 只有表头或完全为空）
instInvalid = RQData::rqInstruments(user, pwd, ["INVALID"])
assert 1, instInvalid.rows() == 0

// --- 1.10 rqTradingDates (交易日历) ---
print("\n=== 测试 rqTradingDates (交易日历) ===")
@testing:case = "test_rqTradingDates"
cal = RQData::rqTradingDates(user, pwd, 2024.11.04, 2024.11.08)
assert 1, cal.rows() == 5
assert 2, "trading_date" in cal.columnNames()
assert 3, cal["trading_date"][0] == "2024-11-04"
assert 4, cal["trading_date"][4] == "2024-11-08"

@testing:case = "test_rqTradingDates_weekend"
// 周末区间无交易日
calWeekend = RQData::rqTradingDates(user, pwd, 2024.10.12, 2024.10.13)
assert 1, calWeekend.rows() == 0

@testing:case = "test_rqTradingDates_start_after_end"
// start > end 返回空表，不报错
calReverse = RQData::rqTradingDates(user, pwd, 2024.11.08, 2024.11.04)
assert 1, calReverse.rows() == 0

