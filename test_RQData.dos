RQData::rqGetPrice(user, pwd, ["AU2412", "000001.XSHE"], 2024.10.08, 2024.10.09, "1d", ["close"])

@testing:case = "test_rqGetPrice_code_with_suffix", exception=1
// 期货代码带交易所后缀（AU2412.SHF）会被拒绝
RQData::rqGetPrice(user, pwd, ["AU2412.SHF"], 2024.10.08, 2024.10.09, "1d")

@testing:case = "test_rqGetPrice_invalid_code", exception=1
// 代码不存在
RQData::rqGetPrice(user, pwd, ["INVALID"], 2024.10.08, 2024.10.09, "1d")

@testing:case = "test_rqGetPrice_minute_with_daily_field", exception=1
// 分钟线不支持 settlement 等日线字段
RQData::rqGetPrice(user, pwd, ["AU2412"], 2024.10.08, 2024.10.09, "1m", ["settlement"])

@testing:case = "test_rqGetPrice_stock_settlement", exception=1
// 股票日线没有结算价 settlement
RQData::rqGetPrice(user, pwd, ["000001.XSHE"], 2024.10.08, 2024.10.09, "1d", ["settlement"])

@testing:case = "test_rqGetPrice_index_open_interest", exception=1
