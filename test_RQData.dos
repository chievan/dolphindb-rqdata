// ====================================================
// 第三部分：并发测试 (Concurrency Tests)
// ====================================================

// --- 3.1 并发 rqGetPrice ---
@testing:case = "test_Concurrent_rqGetPrice"
print("\n=== 并发测试 rqGetPrice ===")
def rqConcurrentPriceTask(u, p, i) {
    t = RQData::rqGetPrice(u, p, ["AU2412"], 2024.10.08, 2024.10.09, "1d", ["close"])
    return t.rows()
}
rPrice = ploop(rqConcurrentPriceTask{user, pwd}, 1..4)
assert 1, size(rPrice) == 4
assert 2, all(rPrice > 0)

// --- 3.2 并发 rqTradingDates ---
@testing:case = "test_Concurrent_rqTradingDates"
print("\n=== 并发测试 rqTradingDates ===")
def rqConcurrentCalendarTask(u, p, i) {
    t = RQData::rqTradingDates(u, p, 2024.11.04, 2024.11.08)
    return t.rows()
}
rCal = ploop(rqConcurrentCalendarTask{user, pwd}, 1..4)
assert 1, size(rCal) == 4
assert 2, all(rCal == 5)

// --- 3.3 多接口并发 (submitJob) ---
@testing:case = "test_Concurrent_mixed_interfaces"
print("\n=== 并发测试 多接口混合 ===")
def rqConcurrentMixedTask(u, p, type) {
    if (type == "price")       return RQData::rqGetPrice(u, p, ["AU2412"], 2024.10.08, 2024.10.09, "1d", ["close"]).rows()
    if (type == "calendar")    return RQData::rqTradingDates(u, p, 2024.11.04, 2024.11.08).rows()
    if (type == "instruments") return RQData::rqInstruments(u, p, ["AU2412"]).rows()
    if (type == "quota")       return RQData::rqGetQuota(u, p).rows()
    return 0
}
jobIds = array(STRING, 0)
jobTypes = ["price", "calendar", "instruments", "quota", "price"]
for (i in 1..5) {
    jobId = "rq_parallel_job_" + string(i)
    submitJob(jobId, "RQData Parallel Test", rqConcurrentMixedTask, user, pwd, jobTypes[i-1])
    jobIds.append!(jobId)
}
for (jid in jobIds) { assert 1, getJobReturn(jid, true) >= 0 }

print("\n--- 全部测试执行完成 ---")
